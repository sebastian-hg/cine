{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/media/**",
          "/icons/**",
          "/posters/**",
          "/productos/**",
          "/combos/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "catalogo",
      "urls": ["/mock/peliculas.json", "/mock/generos.json", "/mock/candy.json"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 40,
        "maxAge": "1h"
      }
    },
    {
      "name": "volatil",
      "urls": ["/mock/configuracion.json", "/mock/resenas.json"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 20,
        "maxAge": "5m",
        "timeout": "3s"
      }
    }
  ]
}
